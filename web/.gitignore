node_modules/
# Root-relative on purpose: a bare `dist/` would also match web/wasm/dist,
# which is the committed /core WASM build.
/dist/

# Synced from web/wasm/dist by scripts/sync-wasm.mjs (npm run sync-wasm).
# The canonical copy is committed under web/wasm/dist; do not commit a second one.
public/wasm/
