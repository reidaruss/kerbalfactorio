# Normalize line endings: text files store LF in the repo, checked out native.
* text=auto eol=lf

# Binary assets (future /ue project) — never normalize/diff as text.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.uasset binary
*.umap   binary
*.fbx    binary
*.wav    binary
*.ogg    binary
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
